<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="org.universe912.demo.MainController"
           styleClass="app-shell">
    <VBox alignment="CENTER"
          maxWidth="560"
          spacing="18"
          styleClass="content-card">
        <padding>
            <Insets top="52" right="64" bottom="52" left="64"/>
        </padding>

        <Label text="中国象棋" styleClass="title"/>
        <Label text="楚河 · 汉界" styleClass="river-mark"/>
        <Label text="JavaFX + Maven 项目已就绪"
               wrapText="true"
               styleClass="subtitle"/>
        <Label fx:id="statusLabel"
               text="下一步可以实现棋盘、棋子和走棋规则。"
               wrapText="true"
               styleClass="status"/>
        <Button text="验证交互"
                onAction="#handleStart"
                styleClass="primary-button"/>
    </VBox>
</StackPane>
